{
  "identifier": "default",
  "description": "DartTrainer Pro default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:scope-appdata-recursive",
    "fs:scope-document-recursive",
    "fs:scope-download-recursive",
    "http:default",
    "http:allow-fetch",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "shell:default",
    "shell:allow-open"
  ]
}
