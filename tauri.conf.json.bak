{
  "productName": "DartTrainer Pro",
  "version": "2.1.0",
  "identifier": "com.darttrainer.pro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DartTrainer Pro",
        "width": 480,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https:; img-src 'self' data: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "fs": {
      "scope": {
        "allow": [
          "$APPDATA/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**"
        ],
        "deny": []
      }
    },
    "http": {
      "scope": {
        "allow": [
          {
            "url": "https://**"
          }
        ]
      }
    },
    "dialog": {
      "all": true
    },
    "shell": {
      "open": true
    }
  }
}